diff --git a/main.tf b/main.tf
index fdf5e9e..e91ef7e 100644
--- a/main.tf
+++ b/main.tf
@@ -7,6 +7,8 @@ module "alb" {
   subnet_ids = var.public_subnet_ids
   app_port   = var.app_port
   services   = var.frontends
+
+  certificate_arn = var.certificate_arn
 }
 
 resource "aws_cloudwatch_log_group" "frontend" {
@@ -14,3 +16,13 @@ resource "aws_cloudwatch_log_group" "frontend" {
   name              = "/ecs/${var.site_name}/${each.key}"
   retention_in_days = 30
 }
+
+resource "aws_cloudwatch_log_group" "edge" {
+  for_each = {
+    access     = 90
+    edge-auth  = 14
+    csp-report = 14
+  }
+  name              = "/${var.site_name}/${var.environment}/${each.key}"
+  retention_in_days = each.value
+}
diff --git a/modules/public-alb/main.tf b/modules/public-alb/main.tf
index 0fd58ec..69d87c7 100644
--- a/modules/public-alb/main.tf
+++ b/modules/public-alb/main.tf
@@ -22,6 +22,10 @@ variable "services" {
   type = list(string)
 }
 
+variable "certificate_arn" {
+  type = string
+}
+
 resource "aws_security_group" "alb" {
   name        = "${var.name}-alb"
   description = "Public ALB for ${var.name}"
@@ -37,6 +41,24 @@ resource "aws_vpc_security_group_ingress_rule" "http" {
   description       = "HTTP from the internet"
 }
 
+resource "aws_vpc_security_group_ingress_rule" "https" {
+  security_group_id = aws_security_group.alb.id
+  cidr_ipv4         = "0.0.0.0/0"
+  ip_protocol       = "tcp"
+  from_port         = 443
+  to_port           = 443
+  description       = "HTTPS from the internet"
+}
+
+resource "aws_vpc_security_group_ingress_rule" "https_v6" {
+  security_group_id = aws_security_group.alb.id
+  cidr_ipv6         = "::/0"
+  ip_protocol       = "tcp"
+  from_port         = 443
+  to_port           = 443
+  description       = "HTTPS from the internet (IPv6)"
+}
+
 resource "aws_vpc_security_group_egress_rule" "to_tasks" {
   security_group_id = aws_security_group.alb.id
   cidr_ipv4         = var.vpc_cidr
@@ -87,6 +109,19 @@ resource "aws_lb_listener" "http" {
   }
 }
 
+resource "aws_lb_listener" "https" {
+  load_balancer_arn = aws_lb.this.arn
+  port              = 443
+  protocol          = "HTTPS"
+  ssl_policy        = "ELBSecurityPolicy-TLS13-1-2-2021-06"
+  certificate_arn   = var.certificate_arn
+
+  default_action {
+    type             = "forward"
+    target_group_arn = aws_lb_target_group.svc["web"].arn
+  }
+}
+
 output "arn_suffix" {
   value = aws_lb.this.arn_suffix
 }
