{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIngestQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:ChangeMessageVisibility",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:eu-west-1:268431905517:prod-ingest-worker"
    },
    {
      "Sid": "ReadRawStatements",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::acme-ledger-raw-prod/incoming/*"
    },
    {
      "Sid": "WriteLedgerTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": "arn:aws:dynamodb:eu-west-1:268431905517:table/prod-ledger-entries"
    }
  ]
}
