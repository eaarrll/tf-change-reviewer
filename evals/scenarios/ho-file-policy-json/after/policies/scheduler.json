{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EnqueueIngestJobs",
      "Effect": "Allow",
      "Action": ["sqs:SendMessage"],
      "Resource": "arn:aws:sqs:eu-west-1:268431905517:prod-ingest-worker"
    },
    {
      "Sid": "ListRawStatements",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::acme-ledger-raw-prod"
    }
  ]
}
